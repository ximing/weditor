{
  "name": "deditor",
  "private": true,
  "version": "0.6.0",
  "description": "Deditor - pageless document editor SDK (ProseMirror, range comments, OT collab)",
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/weditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/weditor.git"
  },
  "bugs": {
    "url": "https://github.com/ximing/weditor/issues"
  },
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "test": "pnpm -r --filter \"./packages/*\" test",
    "lint": "eslint .",
    "dev:demo": "pnpm --filter @deditor/demo dev",
    "dev:docs": "pnpm --filter @deditor/docs dev",
    "dev:collab": "pnpm --filter @deditor/collab-server start"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "eslint": "9.9.0",
    "typescript": "5.5.4",
    "typescript-eslint": "^8.3.0",
    "vitest": "2.0.5",
    "vite": "6.0.3",
    "tsup": "^8.2.4",
    "happy-dom": "^15.7.4"
  }
}

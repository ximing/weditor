{
  "name": "@deditor/react",
  "version": "0.6.0",
  "description": "React DocEditor surface: toolbar, bubbles, find, and comment sidebar.",
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/weditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/weditor.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/ximing/weditor/issues"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "rich-text",
    "collaborative-editing",
    "comments",
    "docs",
    "deditor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/style.css src/tokens.css dist/",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@deditor/collab": "workspace:*",
    "@deditor/core": "workspace:*",
    "@deditor/preset-docs": "workspace:*",
    "@floating-ui/react": "^0.27.0",
    "lucide-react": "^0.454.0",
    "prosemirror-state": "^1",
    "prosemirror-tables": "^1.6.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "18",
    "@types/react-dom": "18",
    "prosemirror-collab": "^1",
    "react": "18",
    "react-dom": "18"
  }
}

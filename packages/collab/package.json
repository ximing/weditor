  "description": "OT collaboration (prosemirror-collab), comment FIFO, and WebSocket provider for Deditor.",
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/weditor/",
  "repository": {
    "type": "git",

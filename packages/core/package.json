{
  "name": "@deditor/core",
  "version": "0.6.0",
  "description": "Framework-agnostic ProseMirror editor: schema merge, commands, comment store, sanitizers.",
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/deditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/deditor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ximing/deditor/issues"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "rich-text",
    "collaborative-editing",
    "comments",
    "docs",
    "deditor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "nanoid": "^5.0.7",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.38.0"
  }
}

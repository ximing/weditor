{
  "name": "@deditor/preset-docs",
  "version": "0.6.0",
  "description": "Pageless Docs schema, commands, keymap, and document CSS for Deditor.",
  "license": "MIT",
  "author": "ximing",
  "homepage": "https://ximing.github.io/weditor/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ximing/weditor.git",
    "directory": "packages/preset-docs"
  },
  "bugs": {
    "url": "https://github.com/ximing/weditor/issues"
  },
  "keywords": [
    "prosemirror",
    "editor",
    "rich-text",
    "collaborative-editing",
    "comments",
    "docs",
    "deditor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && cp src/style.css dist/style.css",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@deditor/core": "workspace:*",
    "nanoid": "^5.0.7",
    "prosemirror-commands": "^1.6.2",
    "prosemirror-dropcursor": "^1.8.1",
    "prosemirror-gapcursor": "^1.3.2",
    "prosemirror-history": "^1.4.1",
    "prosemirror-keymap": "^1.2.2",
    "prosemirror-model": "^1.24.1",
    "prosemirror-schema-list": "^1.4.1",
    "prosemirror-state": "^1.4.3",
    "prosemirror-tables": "^1.6.4",
    "prosemirror-transform": "^1.10.2",
    "prosemirror-view": "^1.38.0"
  }
}
